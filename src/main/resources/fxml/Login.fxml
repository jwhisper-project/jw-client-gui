<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.artshp.jwhisper.client.gui.controller.LoginController"
      alignment="CENTER" spacing="15.0"
      prefWidth="350" prefHeight="450">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="JWhisper Authenticator" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField" promptText="Username"/>
    <Button fx:id="connectButton" text="Connect" onAction="#handleConnect" maxWidth="Infinity" styleClass="success"/>
    <Label fx:id="statusLabel" text="App Skeleton Active" styleClass="text-muted"/>
</VBox>
