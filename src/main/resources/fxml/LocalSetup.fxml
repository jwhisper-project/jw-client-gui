<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.artshp.jwhisper.client.gui.controller.LocalSetupController"
      alignment="CENTER" spacing="20.0" prefWidth="380" prefHeight="480">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Initialize Identity" styleClass="title-2"/>
    <Label text="No local cryptographic identity found. Create a master key pair to secure your communication."
           styleClass="muted" wrapText="true"/>

    <PasswordField fx:id="masterPasswordField" promptText="Choose a strong Master Password"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Master Password"
                   onAction="#handleGenerateIdentity"/>

    <Button fx:id="generateButton" text="Generate keys &amp; save" onAction="#handleGenerateIdentity"
            maxWidth="Infinity" styleClass="accent"/>

    <Label fx:id="errorLabel" styleClass="danger" wrapText="true"/>
</VBox>
